# Documentation only: Spring Boot does not automatically load .env.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside/repository/firebase-service-account.json
FIREBASE_PROJECT_ID=your-project-id
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
GEMINI_API_KEY=your-gemini-api-key
APP_AI_MODEL=google-genai
GEMINI_MODEL=gemini-2.5-flash
APP_STORAGE_TYPE=cloudinary
APP_UPLOAD_MAX_BYTES=10485760
APP_UPLOAD_MAX_SIZE=10MB
APP_UPLOAD_MAX_REQUEST_SIZE=11MB
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
